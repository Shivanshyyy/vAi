                if (typeI == DTYPE_F32) bufferO_4f32[dst] = bufferI7_4f32[src];
                else bufferO_4f32[dst] = vec4(bufferI7_4f16[src]);
            } else {
                if (typeI == DTYPE_F16) bufferO_4f16[dst] = bufferI7_4f16[src];
