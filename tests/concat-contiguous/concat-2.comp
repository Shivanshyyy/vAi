            break;
        case 4u:
            if (typeO == DTYPE_F32) {
                if (typeI == DTYPE_F32) bufferO_2f32[dst] = bufferI4_2f32[src];
                else bufferO_2f32[dst] = vec2(bufferI4_2f16[src]);
            } else {
                if (typeI == DTYPE_F16) bufferO_2f16[dst] = bufferI4_2f16[src];
                else bufferO_2f16[dst] = f16vec2(bufferI4_2f32[src]);
            }
            break;
        case 5u:
            if (typeO == DTYPE_F32) {
                if (typeI == DTYPE_F32) bufferO_2f32[dst] = bufferI5_2f32[src];
