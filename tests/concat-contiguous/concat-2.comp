/*=============================================================================
 concat.comp:
     O = concat(I0 .. I7) along one axis, with optional dtype conversion.

 - packable: 1 / 2 / 4 tensor elements per invocation; all input runs are aligned.
 - contiguous=true: packed input prefix sums, dispatch2(largest input pack count, N).
 - Gather: scalar axis prefix sums; innerSize is the product after the axis.
   dispatch(sum(ceil(inputElements / packable / 256)), 1, 1).
   Each input owns its own workgroup range, so unequal lengths add no empty ranges.
=============================================================================*/
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_16bit_storage : require
#include "common/spec_constants.h"

layout(local_size_x = 256) in;

layout(constant_id = 0) const uint packable = 1; // 1: scalar, 2: vec2, 4: vec4
layout(constant_id = 1) const bool contiguous = false; // linear input runs; source is dispatch Y
layout(constant_id = SPEC_ID_TYPE_O) const uint typeO = 0; // output dtype
layout(constant_id = SPEC_ID_TYPE_I) const uint typeI = 0; // shared input dtype

layout(set = 0, binding = 0) buffer O_BUF_F32 { float bufferO_f32[]; };
layout(set = 0, binding = 0) buffer O_BUF_2F32 { vec2 bufferO_2f32[]; };
layout(set = 0, binding = 0) buffer O_BUF_4F32 { vec4 bufferO_4f32[]; };
layout(set = 0, binding = 0) buffer O_BUF_F16 { float16_t bufferO_f16[]; };
layout(set = 0, binding = 0) buffer O_BUF_2F16 { f16vec2 bufferO_2f16[]; };
layout(set = 0, binding = 0) buffer O_BUF_4F16 { f16vec4 bufferO_4f16[]; };

layout(set = 0, binding = 1) buffer I0_BUF_F32 { float bufferI0_f32[]; };
layout(set = 0, binding = 1) buffer I0_BUF_2F32 { vec2 bufferI0_2f32[]; };
layout(set = 0, binding = 1) buffer I0_BUF_4F32 { vec4 bufferI0_4f32[]; };
layout(set = 0, binding = 1) buffer I0_BUF_F16 { float16_t bufferI0_f16[]; };
layout(set = 0, binding = 1) buffer I0_BUF_2F16 { f16vec2 bufferI0_2f16[]; };
layout(set = 0, binding = 1) buffer I0_BUF_4F16 { f16vec4 bufferI0_4f16[]; };

layout(set = 0, binding = 2) buffer I1_BUF_F32 { float bufferI1_f32[]; };
layout(set = 0, binding = 2) buffer I1_BUF_2F32 { vec2 bufferI1_2f32[]; };
layout(set = 0, binding = 2) buffer I1_BUF_4F32 { vec4 bufferI1_4f32[]; };
layout(set = 0, binding = 2) buffer I1_BUF_F16 { float16_t bufferI1_f16[]; };
layout(set = 0, binding = 2) buffer I1_BUF_2F16 { f16vec2 bufferI1_2f16[]; };
layout(set = 0, binding = 2) buffer I1_BUF_4F16 { f16vec4 bufferI1_4f16[]; };

layout(set = 0, binding = 3) buffer I2_BUF_F32 { float bufferI2_f32[]; };
layout(set = 0, binding = 3) buffer I2_BUF_2F32 { vec2 bufferI2_2f32[]; };
layout(set = 0, binding = 3) buffer I2_BUF_4F32 { vec4 bufferI2_4f32[]; };
layout(set = 0, binding = 3) buffer I2_BUF_F16 { float16_t bufferI2_f16[]; };
layout(set = 0, binding = 3) buffer I2_BUF_2F16 { f16vec2 bufferI2_2f16[]; };
layout(set = 0, binding = 3) buffer I2_BUF_4F16 { f16vec4 bufferI2_4f16[]; };

layout(set = 0, binding = 4) buffer I3_BUF_F32 { float bufferI3_f32[]; };
layout(set = 0, binding = 4) buffer I3_BUF_2F32 { vec2 bufferI3_2f32[]; };
layout(set = 0, binding = 4) buffer I3_BUF_4F32 { vec4 bufferI3_4f32[]; };
layout(set = 0, binding = 4) buffer I3_BUF_F16 { float16_t bufferI3_f16[]; };
layout(set = 0, binding = 4) buffer I3_BUF_2F16 { f16vec2 bufferI3_2f16[]; };
layout(set = 0, binding = 4) buffer I3_BUF_4F16 { f16vec4 bufferI3_4f16[]; };

layout(set = 0, binding = 5) buffer I4_BUF_F32 { float bufferI4_f32[]; };
layout(set = 0, binding = 5) buffer I4_BUF_2F32 { vec2 bufferI4_2f32[]; };
layout(set = 0, binding = 5) buffer I4_BUF_4F32 { vec4 bufferI4_4f32[]; };
layout(set = 0, binding = 5) buffer I4_BUF_F16 { float16_t bufferI4_f16[]; };
layout(set = 0, binding = 5) buffer I4_BUF_2F16 { f16vec2 bufferI4_2f16[]; };
layout(set = 0, binding = 5) buffer I4_BUF_4F16 { f16vec4 bufferI4_4f16[]; };

layout(set = 0, binding = 6) buffer I5_BUF_F32 { float bufferI5_f32[]; };
layout(set = 0, binding = 6) buffer I5_BUF_2F32 { vec2 bufferI5_2f32[]; };
layout(set = 0, binding = 6) buffer I5_BUF_4F32 { vec4 bufferI5_4f32[]; };
layout(set = 0, binding = 6) buffer I5_BUF_F16 { float16_t bufferI5_f16[]; };
layout(set = 0, binding = 6) buffer I5_BUF_2F16 { f16vec2 bufferI5_2f16[]; };
layout(set = 0, binding = 6) buffer I5_BUF_4F16 { f16vec4 bufferI5_4f16[]; };

layout(set = 0, binding = 7) buffer I6_BUF_F32 { float bufferI6_f32[]; };
layout(set = 0, binding = 7) buffer I6_BUF_2F32 { vec2 bufferI6_2f32[]; };
layout(set = 0, binding = 7) buffer I6_BUF_4F32 { vec4 bufferI6_4f32[]; };
layout(set = 0, binding = 7) buffer I6_BUF_F16 { float16_t bufferI6_f16[]; };
layout(set = 0, binding = 7) buffer I6_BUF_2F16 { f16vec2 bufferI6_2f16[]; };
layout(set = 0, binding = 7) buffer I6_BUF_4F16 { f16vec4 bufferI6_4f16[]; };

layout(set = 0, binding = 8) buffer I7_BUF_F32 { float bufferI7_f32[]; };
layout(set = 0, binding = 8) buffer I7_BUF_2F32 { vec2 bufferI7_2f32[]; };
layout(set = 0, binding = 8) buffer I7_BUF_4F32 { vec4 bufferI7_4f32[]; };
layout(set = 0, binding = 8) buffer I7_BUF_F16 { float16_t bufferI7_f16[]; };
layout(set = 0, binding = 8) buffer I7_BUF_2F16 { f16vec2 bufferI7_2f16[]; };
layout(set = 0, binding = 8) buffer I7_BUF_4F16 { f16vec4 bufferI7_4f16[]; };

layout(push_constant) uniform PushConstants {
    uint totalElements;
    uint innerSize;
    uint concatDimOut;
    uint inputCount;
    uint prefixSum[8]; // inclusive axis sizes, or packed counts when contiguous=true
};

void writeO(uint source, uint src, uint dst)
{
    switch (source) {
        case 0u:
            if (typeO == DTYPE_F32) {
                if (typeI == DTYPE_F32) bufferO_f32[dst] = bufferI0_f32[src];
                else bufferO_f32[dst] = float(bufferI0_f16[src]);
            } else {
                if (typeI == DTYPE_F16) bufferO_f16[dst] = bufferI0_f16[src];
                else bufferO_f16[dst] = float16_t(bufferI0_f32[src]);
            }
            break;
        case 1u:
            if (typeO == DTYPE_F32) {
                if (typeI == DTYPE_F32) bufferO_f32[dst] = bufferI1_f32[src];
                else bufferO_f32[dst] = float(bufferI1_f16[src]);
            } else {
                if (typeI == DTYPE_F16) bufferO_f16[dst] = bufferI1_f16[src];
                else bufferO_f16[dst] = float16_t(bufferI1_f32[src]);
            }
            break;
        case 2u:
            if (typeO == DTYPE_F32) {
                if (typeI == DTYPE_F32) bufferO_f32[dst] = bufferI2_f32[src];
                else bufferO_f32[dst] = float(bufferI2_f16[src]);
            } else {
                if (typeI == DTYPE_F16) bufferO_f16[dst] = bufferI2_f16[src];
                else bufferO_f16[dst] = float16_t(bufferI2_f32[src]);
            }
            break;
        case 3u:
            if (typeO == DTYPE_F32) {
                if (typeI == DTYPE_F32) bufferO_f32[dst] = bufferI3_f32[src];
                else bufferO_f32[dst] = float(bufferI3_f16[src]);
            } else {
                if (typeI == DTYPE_F16) bufferO_f16[dst] = bufferI3_f16[src];
                else bufferO_f16[dst] = float16_t(bufferI3_f32[src]);
            }
            break;
        case 4u:
            if (typeO == DTYPE_F32) {
                if (typeI == DTYPE_F32) bufferO_f32[dst] = bufferI4_f32[src];
                else bufferO_f32[dst] = float(bufferI4_f16[src]);
            } else {
                if (typeI == DTYPE_F16) bufferO_f16[dst] = bufferI4_f16[src];
                else bufferO_f16[dst] = float16_t(bufferI4_f32[src]);
            }
            break;
        case 5u:
            if (typeO == DTYPE_F32) {
                if (typeI == DTYPE_F32) bufferO_f32[dst] = bufferI5_f32[src];
                else bufferO_f32[dst] = float(bufferI5_f16[src]);
            } else {
                if (typeI == DTYPE_F16) bufferO_f16[dst] = bufferI5_f16[src];
                else bufferO_f16[dst] = float16_t(bufferI5_f32[src]);
            }
            break;
        case 6u:
            if (typeO == DTYPE_F32) {
                if (typeI == DTYPE_F32) bufferO_f32[dst] = bufferI6_f32[src];
                else bufferO_f32[dst] = float(bufferI6_f16[src]);
            } else {
                if (typeI == DTYPE_F16) bufferO_f16[dst] = bufferI6_f16[src];
                else bufferO_f16[dst] = float16_t(bufferI6_f32[src]);
            }
            break;
        case 7u:
            if (typeO == DTYPE_F32) {
                if (typeI == DTYPE_F32) bufferO_f32[dst] = bufferI7_f32[src];
                else bufferO_f32[dst] = float(bufferI7_f16[src]);
            } else {
                if (typeI == DTYPE_F16) bufferO_f16[dst] = bufferI7_f16[src];
                else bufferO_f16[dst] = float16_t(bufferI7_f32[src]);
            }
            break;
    }
}

