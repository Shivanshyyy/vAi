            if (typeO == DTYPE_F32) {
                if (typeI == DTYPE_F32) bufferO_4f32[dst] = bufferI2_4f32[src];
                else bufferO_4f32[dst] = vec4(bufferI2_4f16[src]);
            } else {
                if (typeI == DTYPE_F16) bufferO_4f16[dst] = bufferI2_4f16[src];
                else bufferO_4f16[dst] = f16vec4(bufferI2_4f32[src]);
