}

void writeO4(uint source, uint src, uint dst)
{
    switch (source) {
        case 0u:
            if (typeO == DTYPE_F32) {
                if (typeI == DTYPE_F32) bufferO_4f32[dst] = bufferI0_4f32[src];
                else bufferO_4f32[dst] = vec4(bufferI0_4f16[src]);
            } else {
                if (typeI == DTYPE_F16) bufferO_4f16[dst] = bufferI0_4f16[src];
