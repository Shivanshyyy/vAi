    }
}

void main()
{
    uint idx = gl_GlobalInvocationID.x;

    if (contiguous) {
        uint source = gl_GlobalInvocationID.y;
        // Host supplies packed inclusive prefix sums in this specialization.
        uint start = 0u;
        if (source > 0u) start = prefixSum[source - 1u];
        uint count = prefixSum[source] - start;
        if (idx >= count) return;
        uint destination = start + idx;
        if (packable == 1u) writeO(source, idx, destination);
        else if (packable == 2u) writeO2(source, idx, destination);
        else writeO4(source, idx, destination);
        return;
    }
    // Assign contiguous workgroup ranges to inputs. Unlike a rectangular
    // (max-input-packs, input-count) grid, this launches only the groups needed
    // by each input. Source selection is uniform throughout a workgroup.
    uint outRunPacks = concatDimOut * innerSize / packable;
    uint outer = totalElements / (concatDimOut * innerSize);
    uint firstGroup = 0u;
    uint start = 0u;
    for (uint source = 0u; source < inputCount; ++source)
    {
        uint end = prefixSum[source];
        uint runPacks = (end - start) * innerSize / packable;
        uint inputPacks = outer * runPacks;
        uint groupCount = (inputPacks + 255u) / 256u;
        if (gl_WorkGroupID.x < firstGroup + groupCount) {
            uint src = (gl_WorkGroupID.x - firstGroup) * 256u + gl_LocalInvocationID.x;
            if (src >= inputPacks) return;
            uint row = src / runPacks;
            uint column = src % runPacks;
            uint destination = row * outRunPacks + start * innerSize / packable + column;
            if (packable == 1u) writeO(source, src, destination);
            else if (packable == 2u) writeO2(source, src, destination);
            else writeO4(source, src, destination);
            return;
        }
        firstGroup += groupCount;
        start = end;
    }
}
