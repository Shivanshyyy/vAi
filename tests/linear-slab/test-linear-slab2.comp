// =============================================================================
// vai-linear-slab2.comp: A/B variant of linear-slab — one subgroup, not
//     one workgroup, owns each slab. Contract-compatible with it (same spec
//     constants, push block, bindings and dispatch grid), but it lives with
//     the test rather than in vAi, so it is loaded by path (LINEAR_SLAB2_SPV)
//     instead of by shader name from the pipeline pool.
//
//     O[j, n] = sum_k I[j, k] * W[n, k],  j < M
//
// Each subgroup owns wgN consecutive N positions (W rows) on its own:
// sgSize lanes stride their K (K_PER_ITER = 4 elements per lane per iteration) and a
// single subgroupAdd stage finishes the reduction — no shared memory, no
// barrier.
// A workgroup is just wgSize / sgSize independent subgroups; the host grid
// stays ceil(N / wgN) (the linear-slab contract), so a multi-subgroup
// wgSize over-covers N and the surplus workgroups exit early — a
// subgroup-sized wgSize maps one-to-one.
//
// Same contract as linear-slab otherwise (spec / push / bindings /
// dispatch); the original uvec4 8-wide fp16 loads became the typed 4-wide
// readers to honor the host's dtype-independent K % 4 contract and the
// typeI / typeO axes.
// - O [M, N] (typeO) and I [M, K] (typeI) are fp32 or fp16 via same-binding
//   buffer aliases; W [N, K] is fp16. Accumulation is fp32. No bias, no
//   epilogue: binding 3 is gone (matches test-linear-slab).
// - M (the flattened batch) is baked into the pipeline as a spec constant,
//   not a push constant. The host dispatches M <= 8 here only.
// - aligned == 1: K % 4 == 0, direct vec4 loads.
//   aligned == 0: scalar-composed loads with a K-tail mask on the last
//   iteration only — any K.
// - wgN == 2 for fp16 W; an N that is not a multiple of wgN leaves a short
//   last group, which main() hands a runtime count (see main).
// - Dispatch (host): (ceil(N / wgN), 1, 1); an oversized N folds the X
//   grid into z (ggml groups_z split) and main() re-linearizes with the
//   z term.
// =============================================================================
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_control_flow_attributes : require
#include "common/spec_constants.h"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;   // = wgSize (same SpecId)

layout(constant_id = 0) const uint wgSize = 128;  // threads per workgroup (= local_size_x)
layout(constant_id = 1) const uint sgSize = 32;   // pinned subgroup size (host requiredSubgroupSize)
layout(constant_id = 2) const uint M      = 1;    // flattened batch = this subgroup's M extent (ggml NUM_COLS)
layout(constant_id = 3) const uint wgN    = 1;    // N positions per subgroup (ggml NUM_ROWS)

layout(constant_id = SPEC_ID_TYPE_O) const uint typeO = 0;  // O (output) dtype
layout(constant_id = SPEC_ID_TYPE_I) const uint typeI = 0;  // I (input) dtype
layout(constant_id = SPEC_ID_ALIGNED) const uint aligned = 1;  // 1: K % 4 == 0, 0: masked K tail

const uint K_PER_ITER = 4;    // k elements per lane per iteration (ggml non-quant width)

layout(set = 0, binding = 0) writeonly buffer O_BUF_F32  { float bufferO_f32[]; };
layout(set = 0, binding = 0) writeonly buffer O_BUF_F16  { float16_t bufferO_f16[]; };
//////////////////////////////////////////////////////////////////////////////
layout(set = 0, binding = 1) readonly buffer I_BUF_F32   { float bufferI_f32[]; };
layout(set = 0, binding = 1) readonly buffer I_BUF_4F32  { vec4 bufferI_4f32[]; };
layout(set = 0, binding = 1) readonly buffer I_BUF_F16   { float16_t bufferI_f16[]; };
layout(set = 0, binding = 1) readonly buffer I_BUF_4F16  { f16vec4 bufferI_4f16[]; };
//////////////////////////////////////////////////////////////////////////////
layout(set = 0, binding = 2) readonly buffer W_BUF_F16   { float16_t bufferW_f16[]; };
layout(set = 0, binding = 2) readonly buffer W_BUF_4F16  { f16vec4 bufferW_4f16[]; };

layout(push_constant) uniform PushConstants {
    uint K;
    uint N;
};

float readI(uint i)    { return (typeI == 0u) ? bufferI_f32[i] : float(bufferI_f16[i]); }
vec4  readI4(uint i4)  { return (typeI == 0u) ? bufferI_4f32[i4] : vec4(bufferI_4f16[i4]); }
float readW(uint i)    { return float(bufferW_f16[i]); }
vec4  readW4(uint i4)  { return vec4(bufferW_4f16[i4]); }
void writeO(uint i, float v) { if (typeO == 0u) bufferO_f32[i] = v; else bufferO_f16[i] = float16_t(v); }

// One K_PER_ITER-wide read at row-relative offset k0: a direct vec4 when
// aligned, scalar-composed otherwise. The K-tail mask runs on the last
// iteration only (ggml load_b OOB pattern); element 0 is always in range
// by the numIters trip-count condition.
vec4 readI4Masked(uint rowBase, uint k0, bool lastIter)
{
    if (aligned != 0u)
        return readI4((rowBase + k0) >> 2);
    return vec4(
        readI(rowBase + k0),
        (lastIter && k0 + 1 >= K) ? 0.0 : readI(rowBase + k0 + 1),
        (lastIter && k0 + 2 >= K) ? 0.0 : readI(rowBase + k0 + 2),
        (lastIter && k0 + 3 >= K) ? 0.0 : readI(rowBase + k0 + 3));
}

vec4 readW4Masked(uint rowBase, uint k0, bool lastIter)
{
    if (aligned != 0u)
        return readW4((rowBase + k0) >> 2);
    return vec4(
        readW(rowBase + k0),
        (lastIter && k0 + 1 >= K) ? 0.0 : readW(rowBase + k0 + 1),
        (lastIter && k0 + 2 >= K) ? 0.0 : readW(rowBase + k0 + 2),
        (lastIter && k0 + 3 >= K) ? 0.0 : readW(rowBase + k0 + 3));
}

// One iteration: this lane's K_PER_ITER chunk. The W rows load once into
// registers and every batch entry's input reuses them (refactor-v2's
// register strategy — the reverse of linear-slab's W-reload shape).
void dotKChunk(inout float sums[M][wgN],
               uint n0, uint nCount, uint lane, uint it, bool lastIter)
{
    const uint k0 = K_PER_ITER * (it * sgSize + lane);

    vec4 wv[wgN];
    uint wRow = n0 * K;
    [[unroll]] for (uint n = 0; n < nCount; n++)
    {
        wv[n] = readW4Masked(wRow, k0, lastIter);
        wRow += K;
    }

    [[unroll]] for (uint j = 0; j < M; j++)
    {
        vec4 iv = readI4Masked(j * K, k0, lastIter);
        [[unroll]] for (uint n = 0; n < nCount; n++)
            sums[j][n] += dot(wv[n], iv);
    }
}

// The nCount outputs starting at N position n0, processed by this subgroup alone:
// accumulate this lane's K chunks, one subgroupAdd, lane 0 stores.
// nCount is compile-time at both call sites —
// wgN for full groups, 1 for the odd-N tail (see main).
void computeOutputs(const uint n0, const uint nCount)
{
    const uint lane = gl_SubgroupInvocationID;

    float sums[M][wgN];
    [[unroll]] for (uint j = 0; j < M; j++)
        [[unroll]] for (uint n = 0; n < wgN; n++)
            sums[j][n] = 0.0;

    // This lane owns the K_PER_ITER-wide chunks at
    // K_PER_ITER * (i * sgSize + lane), i = 0..numIters-1.
    uint numIters = K / (K_PER_ITER * sgSize);
    if (numIters * K_PER_ITER * sgSize + K_PER_ITER * lane < K)
        numIters++;

    // refactor-v2's schedule: 4-deep unroll, then the remainder one at a
    // time. With an unaligned K the final iteration must run lastIter == true
    // for the OOB masks, so it is pushed out of the unrolled loop.
    const uint unrollDepth = 4;
    uint unrolledIters = numIters & ~(unrollDepth - 1);
    if (aligned == 0u && unrolledIters == numIters && unrolledIters > 0)
        unrolledIters -= unrollDepth;

    uint i = 0;
    while (i < unrolledIters)
    {
        [[unroll]] for (uint u = 0; u < unrollDepth; u++)
        {
            dotKChunk(sums, n0, nCount, lane, i, false);
            i++;
        }
    }

    while (i < numIters)
    {
        dotKChunk(sums, n0, nCount, lane, i, true);
        i++;
    }

    // Reduce + store: one subgroupAdd per (batch entry, row); lane 0 stores.
    [[unroll]] for (uint j = 0; j < M; j++)
        [[unroll]] for (uint n = 0; n < nCount; n++)
            sums[j][n] = subgroupAdd(sums[j][n]);

    if (lane != 0) return;
    [[unroll]] for (uint j = 0; j < M; j++)
        [[unroll]] for (uint n = 0; n < nCount; n++)
            writeO(j * N + n0 + n, sums[j][n]);
}

void main()
{
    // wgSize / sgSize independent subgroups per workgroup; with the grid
    // fixed at ceil(N / wgN), a multi-subgroup wgSize over-covers N and
    // the surplus exits here — wgSize == sgSize maps one-to-one.
    // x + numWG.x * z re-linearizes the z-split grid (identity when gz == 1).
    const uint wgIdx    = gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z;
    const uint n0 = (wgIdx * (wgSize / sgSize) + gl_SubgroupID) * wgN;
    if (n0 >= N)
        return;

    // Full groups pass wgN so nCount stays a compile-time constant there (the
    // sums indexing folds to literals); only the single last group can be
    // short and takes a runtime count.
    if (n0 + wgN <= N)
        computeOutputs(n0, wgN);
    else
        computeOutputs(n0, N - n0);
}
