// =============================================================================
// test-linear-slab-v2.comp: test-linear-slab-v0 with the shared array and the
//     cross-subgroup fold put back. That is the only difference between the two
//     files, and at wgSize == sgSize the fold does not run in either — so the
//     pair isolates one thing: whether declaring 8 bytes of workgroup memory
//     costs anything.
//
// Against test-linear-slab:
// 1. tid comes from the subgroup, not gl_LocalInvocationID.x, and a lane
//    strides its K by sgSize rather than wgSize.
// 2. The W rows load into registers before any arithmetic, instead of being
//    read inside the accumulate loop.
// 3. The 2-deep unroll stage is gone, leaving 4-deep and the tail.
// 4. K_PER_ITER is fixed at 4 rather than a spec constant, so the K_PER_ITER/4
//    wrapper loop goes with it.
//
// The lane term in 1 is what makes this file not a drop-in for
// test-linear-slab. A lane strides its K by sgSize, so every subgroup of a
// wider workgroup would walk the same slab and the fold below would then sum
// those duplicates. The host must pass wgSize == sgSize (SlabV2Node asserts
// it); the wgSize > sgSize geometry long-K shapes want is
// test-linear-slab-v5's.
//
// The rest is test-linear-slab's contract: O/I dtype axes, fp16 W, M as a spec
// constant, aligned == 0 masking the K tail, a short last group taking a
// runtime count, and the host's ceil(N / wgN) grid.
// =============================================================================
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_control_flow_attributes : require
#include "common/spec_constants.h"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;   // = wgSize (same SpecId)

layout(constant_id = 0) const uint wgSize = 128;  // threads per workgroup (= local_size_x); host pins it to sgSize
layout(constant_id = 1) const uint sgSize = 32;   // pinned subgroup size (host requiredSubgroupSize)
layout(constant_id = 2) const uint M      = 1;    // flattened batch = this subgroup's M extent
layout(constant_id = 3) const uint wgN    = 1;    // N positions per subgroup

layout(constant_id = SPEC_ID_TYPE_O) const uint typeO = 0;  // O (output) dtype
layout(constant_id = SPEC_ID_TYPE_I) const uint typeI = 0;  // I (input) dtype
layout(constant_id = SPEC_ID_ALIGNED) const uint aligned = 1;  // 1: K % 4 == 0, 0: masked K tail

const uint K_PER_ITER = 4;   // k elements per lane per iteration

layout(set = 0, binding = 0) writeonly buffer O_BUF_F32  { float bufferO_f32[]; };
layout(set = 0, binding = 0) writeonly buffer O_BUF_F16  { float16_t bufferO_f16[]; };
//////////////////////////////////////////////////////////////////////////////
layout(set = 0, binding = 1) readonly buffer I_BUF_F32   { float bufferI_f32[]; };
layout(set = 0, binding = 1) readonly buffer I_BUF_4F32  { vec4 bufferI_4f32[]; };
layout(set = 0, binding = 1) readonly buffer I_BUF_F16   { float16_t bufferI_f16[]; };
layout(set = 0, binding = 1) readonly buffer I_BUF_4F16  { f16vec4 bufferI_4f16[]; };
//////////////////////////////////////////////////////////////////////////////
layout(set = 0, binding = 2) readonly buffer W_BUF_F16   { float16_t bufferW_f16[]; };
layout(set = 0, binding = 2) readonly buffer W_BUF_4F16  { f16vec4 bufferW_4f16[]; };

layout(push_constant) uniform PushConstants {
    uint K;
    uint N;
};

float readI(uint i)    { return (typeI == 0u) ? bufferI_f32[i] : float(bufferI_f16[i]); }
vec4  readI4(uint i4)  { return (typeI == 0u) ? bufferI_4f32[i4] : vec4(bufferI_4f16[i4]); }
float readW(uint i)    { return float(bufferW_f16[i]); }
vec4  readW4(uint i4)  { return vec4(bufferW_4f16[i4]); }
void writeO(uint i, float v) { if (typeO == 0u) bufferO_f32[i] = v; else bufferO_f16[i] = float16_t(v); }

// One vec4 read at row-relative offset k0: direct when aligned, scalar-composed
// otherwise. The K-tail mask runs on the last iteration only (ggml load_b OOB
// pattern); element 0 is always in range by the numIters trip-count condition.
vec4 readI4Masked(uint rowBase, uint k0, bool lastIter)
{
    if (aligned != 0u)
        return readI4((rowBase + k0) >> 2);
    return vec4(
        (lastIter && k0 + 0 >= K) ? 0.0 : readI(rowBase + k0),
        (lastIter && k0 + 1 >= K) ? 0.0 : readI(rowBase + k0 + 1),
        (lastIter && k0 + 2 >= K) ? 0.0 : readI(rowBase + k0 + 2),
        (lastIter && k0 + 3 >= K) ? 0.0 : readI(rowBase + k0 + 3));
}

vec4 readW4Masked(uint rowBase, uint k0, bool lastIter)
{
    if (aligned != 0u)
        return readW4((rowBase + k0) >> 2);
    return vec4(
        (lastIter && k0 + 0 >= K) ? 0.0 : readW(rowBase + k0),
        (lastIter && k0 + 1 >= K) ? 0.0 : readW(rowBase + k0 + 1),
        (lastIter && k0 + 2 >= K) ? 0.0 : readW(rowBase + k0 + 2),
        (lastIter && k0 + 3 >= K) ? 0.0 : readW(rowBase + k0 + 3));
}

// One iteration: this lane's K_PER_ITER chunk dotted for every
// (batch entry, N position) pair.
void dotKChunk(inout float sums[M][wgN],
               uint n0, uint nCount, uint lane, uint it, bool lastIter)
{
    const uint k0 = K_PER_ITER * (it * sgSize + lane);

    // Every W row this lane needs is issued before the first dot, so the loads
    // overlap instead of each one gating the next.
    vec4 wv[wgN];
    uint wRow = n0 * K;
    [[unroll]] for (uint n = 0; n < nCount; n++)
    {
        wv[n] = readW4Masked(wRow, k0, lastIter);
        wRow += K;
    }

    [[unroll]] for (uint j = 0; j < M; j++)
    {
        vec4 iv = readI4Masked(j * K, k0, lastIter);
        [[unroll]] for (uint n = 0; n < nCount; n++)
            sums[j][n] += dot(wv[n], iv);
    }
}

// Per-(batch entry, N position, subgroup) partials for the cross-subgroup fold
// below. Third dim is the subgroup count, which gl_SubgroupID indexes exactly:
// the pipeline pins the subgroup size, so wgSize / sgSize is what the device
// launches.
shared float tmpsh[M][wgN][wgSize / sgSize];

// The nCount outputs starting at N position n0, finished by this subgroup
// alone. nCount is wgN for full groups and a runtime remainder for the short
// last one (see main).
void computeOutputs(const uint n0, const uint nCount)
{
    const uint lane = gl_SubgroupInvocationID;

    float sums[M][wgN];
    [[unroll]] for (uint j = 0; j < M; j++)
        [[unroll]] for (uint n = 0; n < wgN; n++)
            sums[j][n] = 0.0;

    // This lane owns the K_PER_ITER-wide chunks at
    // K_PER_ITER * (i * sgSize + lane), i = 0..numIters-1.
    uint numIters = K / (K_PER_ITER * sgSize);
    if (numIters * K_PER_ITER * sgSize + K_PER_ITER * lane < K)
        numIters++;

    // 4-deep and then the tail. With an unaligned K the final iteration must
    // run lastIter == true for the OOB masks, so it is pushed out of the
    // unrolled loop.
    const uint unrollCount = 4;
    uint unrolledIters = numIters & ~(unrollCount - 1);
    if (aligned == 0u && unrolledIters == numIters && unrolledIters > 0)
        unrolledIters -= unrollCount;

    uint i = 0;
    while (i < unrolledIters)
    {
        [[unroll]] for (uint u = 0; u < unrollCount; u++)
        {
            dotKChunk(sums, n0, nCount, lane, i, false);
            i++;
        }
    }

    while (i < numIters)
    {
        dotKChunk(sums, n0, nCount, lane, i, true);
        i++;
    }

    // Reduce: subgroupAdd within each subgroup; multi-subgroup workgroups
    // (wgSize > sgSize — spec-folded, so each pipeline compiles to exactly
    // one mode) fold the per-subgroup partials through tmpsh.
    [[unroll]] for (uint j = 0; j < M; j++)
        [[unroll]] for (uint n = 0; n < nCount; n++)
            sums[j][n] = subgroupAdd(sums[j][n]);

    if (wgSize > sgSize)
    {
        if (lane == 0)
            [[unroll]] for (uint j = 0; j < M; j++)
                [[unroll]] for (uint n = 0; n < nCount; n++)
                    tmpsh[j][n][gl_SubgroupID] = sums[j][n];
        barrier();
        if (lane == 0)
        {
            [[unroll]] for (uint j = 0; j < M; j++)
            {
                [[unroll]] for (uint n = 0; n < nCount; n++)
                {
                    sums[j][n] = 0.0;
                    [[unroll]] for (uint s = 0; s < gl_NumSubgroups; s++)
                        sums[j][n] += tmpsh[j][n][s];
                }
            }
        }
    }

    if (lane != 0) return;
    [[unroll]] for (uint j = 0; j < M; j++)
        [[unroll]] for (uint n = 0; n < nCount; n++)
            writeO(j * N + n0 + n, sums[j][n]);
}

void main()
{
    // x + numWG.x * z re-linearizes the z-split grid (identity when gz == 1).
    const uint n0 = (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z) * wgN;
    if (n0 >= N)
        return;

    // Full groups pass wgN so nCount stays a compile-time constant there (the
    // sums indexing folds to literals); only the last group can be short and
    // takes a runtime count.
    if (n0 + wgN <= N)
        computeOutputs(n0, wgN);
    else
        computeOutputs(n0, N - n0);
}
