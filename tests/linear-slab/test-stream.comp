// =============================================================================
// test-stream.comp: read bandwidth roofline. Streams a buffer and does nothing
//     else, so its rate is the ceiling test-linear-slab is measured against.
//
// A grid-stride loop over f16vec4: adjacent lanes read adjacent 8-byte slots,
// so a subgroup covers one contiguous span per pass and the whole grid sweeps
// the buffer front to back. That is the same shape a slab dispatch produces
// when its workgroups march their W rows, with the dot products, the reduction,
// the shared memory and the second buffer removed.
//
// The store is guarded by a comparison that never holds. Without it the loads
// feed nothing and the compiler deletes the loop; with it the reads have to
// happen, and the store never does.
//
// The buffer must be larger than the last-level cache or this measures the
// cache instead — the host passes an lm-head-sized one.
// =============================================================================
#version 450
#extension GL_EXT_shader_16bit_storage : require

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout(constant_id = 0) const uint wgSize = 64;   // threads per workgroup (= local_size_x)

layout(set = 0, binding = 0) writeonly buffer O_BUF { float bufferO[]; };
layout(set = 0, binding = 1) readonly  buffer W_BUF { f16vec4 bufferW[]; };

layout(push_constant) uniform PushConstants {
    uint count;   // f16vec4 elements in W
};

void main()
{
    const uint stride = gl_NumWorkGroups.x * wgSize;

    vec4 acc = vec4(0.0);
    for (uint i = gl_GlobalInvocationID.x; i < count; i += stride)
        acc += vec4(bufferW[i]);

    const float s = acc.x + acc.y + acc.z + acc.w;
    if (s == 1e30)
        bufferO[gl_GlobalInvocationID.x] = s;
}
