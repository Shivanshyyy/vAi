/*=============================================================================
 linear-naive.comp:   Linear / fully-connected layer (NT)
     O[m, n] = epilogue( sum_k I[m, k] * W[n, k] + bias[n] )

 - O [M, N] (typeO), I [M, K] (typeI), W [N, K] / bias [N] (typeW) are each
   fp32 or fp16, accessed through same-binding buffer aliases (scalar / vec4).
 - aligned == 1: K must be a multiple of 4 (any typeI / typeW). Wide path:
   one vec4 / f16vec4 load each for I and W per iteration.
   aligned == 0: scalar loop, no alignment requirement on K.
 - One thread per output element. Dispatch (host): (N, M).
=============================================================================*/
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_16bit_storage : require
#include "common/activation.h"
#include "common/spec_constants.h"

layout(local_size_x = 32, local_size_y = 32) in;

layout(constant_id = 0) const uint hasBias  = 1;  // 0: no bias, 1: bias[N]
layout(constant_id = SPEC_ID_TYPE_O) const uint typeO    = 0;  // O (output) dtype
layout(constant_id = SPEC_ID_TYPE_I) const uint typeI    = 0;  // I (input) dtype
layout(constant_id = SPEC_ID_TYPE_W) const uint typeW    = 0;  // W (weight) and bias dtype
layout(constant_id = SPEC_ID_ALIGNED) const uint aligned = 1;  // 0: no alignment, 1: K is multiple of 4

layout(set = 0, binding = 0) buffer O_BUF_F32   { float bufferO_f32[]; };
layout(set = 0, binding = 0) buffer O_BUF_F16   { float16_t bufferO_f16[]; };
//////////////////////////////////////////////////////////////////////////////
layout(set = 0, binding = 1) buffer I_BUF_F32   { float bufferI_f32[]; };
layout(set = 0, binding = 1) buffer I_BUF_4F32  { vec4 bufferI_4f32[]; };
layout(set = 0, binding = 1) buffer I_BUF_F16   { float16_t bufferI_f16[]; };
layout(set = 0, binding = 1) buffer I_BUF_4F16  { f16vec4 bufferI_4f16[]; };
//////////////////////////////////////////////////////////////////////////////
layout(set = 0, binding = 2) buffer W_BUF_F32   { float bufferW_f32[]; };
layout(set = 0, binding = 2) buffer W_BUF_4F32  { vec4 bufferW_4f32[]; };
layout(set = 0, binding = 2) buffer W_BUF_F16   { float16_t bufferW_f16[]; };
layout(set = 0, binding = 2) buffer W_BUF_4F16  { f16vec4 bufferW_4f16[]; };
//////////////////////////////////////////////////////////////////////////////
layout(set = 0, binding = 3) buffer BIAS_BUF_32 { float bufferBias_f32[]; };
layout(set = 0, binding = 3) buffer BIAS_BUF_16 { float16_t bufferBias_f16[]; };

layout(push_constant) uniform PushConstants {
    uint M;
    uint K;
    uint N;
};

float readI(uint i)    { return (typeI == DTYPE_F32) ? bufferI_f32[i] : float(bufferI_f16[i]); }
vec4  readI4(uint i4)  { return (typeI == DTYPE_F32) ? bufferI_4f32[i4] : vec4(bufferI_4f16[i4]); }
float readW(uint i)    { return (typeW == DTYPE_F32) ? bufferW_f32[i] : float(bufferW_f16[i]); }
vec4  readW4(uint i4)  { return (typeW == DTYPE_F32) ? bufferW_4f32[i4] : vec4(bufferW_4f16[i4]); }
float readBias(uint n) { return (hasBias == 0u) ? 0.0 : ((typeW == DTYPE_F32) ? bufferBias_f32[n] : float(bufferBias_f16[n])); }
void writeO(uint i, float v) { if (typeO == DTYPE_F32) bufferO_f32[i] = v; else bufferO_f16[i] = float16_t(v); }

void main()
{
    uint n = gl_GlobalInvocationID.x;
    uint m = gl_GlobalInvocationID.y;
    if (m >= M || n >= N) return;

    float sum = readBias(n);
    uint iRow = m * K;
    uint wRow = n * K;

    uint KK = (aligned != 0u) ? K >> 2 : K;
    uint iOff = (aligned != 0u) ? iRow >> 2 : iRow;
    uint wOff = (aligned != 0u) ? wRow >> 2 : wRow;

    for (uint k = 0u; k < KK; ++k)
    {
        sum += (aligned != 0u)
            ? dot(readI4(iOff + k), readW4(wOff + k))
            : readI(iOff + k) * readW(wOff + k);
    }

    writeO(m * N + n, applyEpilogue(sum));
}
