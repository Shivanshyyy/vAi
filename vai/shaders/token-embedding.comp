/*=============================================================================
 token-embedding.comp:
     token (+ optional positional) embedding lookup, scaled.
       O[n, d] = scale * W[tokenIds[n], d]                          (hasPosEmbed = 0)
       O[n, d] = scale * W[tokenIds[n], d] + posW[kvCacheCount + n, d]  (= 1)

 - W        : [V, D]
 - posW     : [M, D]   (only read when hasPosEmbed = 1)
 - tokenIds : [..., T] (raw uint32; the leading axes are more sequences)
 - O        : [..., T, D]
 - O (typeO) and W / posW (typeW) are fp32 or fp16, accessed through
   same-binding buffer aliases.
 - dispatch : (ceil(D / 32), ceil(rows / 4)) workgroups
=============================================================================*/
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_16bit_storage : require
#include "common/spec_constants.h"

layout(local_size_x = 32, local_size_y = 4) in;

layout(constant_id = 0) const uint hasPosEmbed = 0;   // 0: token only, 1: token + positional
layout(constant_id = 1) const uint batched = 0;       // 0: one sequence, so n is the position
layout(constant_id = SPEC_ID_TYPE_O) const uint typeO = 0;  // O (output) dtype
layout(constant_id = SPEC_ID_TYPE_W) const uint typeW = 0;  // W / posW dtype

layout(set = 0, binding = 0) buffer O_BUF_F32    { float bufferO_f32[]; };      // embedding [..., T, D]
layout(set = 0, binding = 0) buffer O_BUF_F16    { float16_t bufferO_f16[]; };
//////////////////////////////////////////////////////////////////////////////
layout(set = 0, binding = 1) buffer I_BUF        { uint bufferI[]; };           // token ids [..., T]
//////////////////////////////////////////////////////////////////////////////
layout(set = 0, binding = 2) buffer W_BUF_F32    { float bufferW_f32[]; };      // token weight [V, D]
layout(set = 0, binding = 2) buffer W_BUF_F16    { float16_t bufferW_f16[]; };
//////////////////////////////////////////////////////////////////////////////
layout(set = 0, binding = 3) buffer POSW_BUF_F32 { float bufferPosW_f32[]; };   // positional weight [M, D]
layout(set = 0, binding = 3) buffer POSW_BUF_F16 { float16_t bufferPosW_f16[]; };
//////////////////////////////////////////////////////////////////////////////
layout(set = 0, binding = 4) uniform UB          { uint kvCacheCount; };    // unused if hasPosEmbed = 0

layout(push_constant) uniform PushConstants {
    uint rows;   // ids this dispatch reads = every sequence's T
    uint T;      // tokens per sequence; positions restart at every one
    uint D;
    float scale;
};

float readW(uint i) { return (typeW == DTYPE_F32) ? bufferW_f32[i] : float(bufferW_f16[i]); }
float readPosW(uint i) { return (typeW == DTYPE_F32) ? bufferPosW_f32[i] : float(bufferPosW_f16[i]); }
void writeO(uint i, float v) { if (typeO == DTYPE_F32) bufferO_f32[i] = v; else bufferO_f16[i] = float16_t(v); }

void main()
{
    uint d = gl_GlobalInvocationID.x;
    uint n = gl_GlobalInvocationID.y;
    if (n >= rows || d >= D) return;

    float v = readW(bufferI[n] * D + d) * scale;
    if (hasPosEmbed != 0u)
    {
        // One sequence leaves n as the position; past that each one starts over.
        uint pos = kvCacheCount + (batched == 0u ? n : n % T);
        v += readPosW(pos * D + d);
    }

    writeO(n * D + d, v);
}
