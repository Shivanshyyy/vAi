/*=============================================================================
 time-embedding.comp:
     Sinusoidal embedding of the timestep t, the same vector on every row, with
     t taken from how many dispatches ran before this one.

 - O (typeO) [rows, D] is fp32 or fp16, accessed through same-binding buffer
   aliases. The angle itself is always fp32.
 - TICKET counts workgroups since the host last zeroed it. Every workgroup of the
   k-th dispatch draws a ticket in [k*W, (k+1)*W), W the workgroups per dispatch,
   so ticket / W is k for all of them and nothing has to be written back.
 - t = 1 - (k % numSteps) / numSteps, exact at every step: nothing accumulates.
 - period_i = minPeriod * 2^(i / (D/2 - 1) * log2Ratio). Only the fraction of a
   cycle, fract(t / period_i), is turned into an angle, so sin and cos stay inside
   one cycle, where their GPU precision is specified.
 - O[r, i] = sin(angle_i), O[r, D/2 + i] = cos(angle_i).

 Dispatch (host): dispatch2(D / 2, rows) -- one thread per sin/cos pair.
=============================================================================*/
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_16bit_storage : require
#include "common/spec_constants.h"

layout(local_size_x = 256) in;

layout(constant_id = SPEC_ID_TYPE_O) const uint typeO = 0;  // O (output) dtype

layout(set = 0, binding = 0) buffer O_BUF_F32 { float bufferO_f32[]; };
layout(set = 0, binding = 0) buffer O_BUF_F16 { float16_t bufferO_f16[]; };
//////////////////////////////////////////////////////////////////////////////
layout(set = 0, binding = 1) buffer TICKET_BUF { uint bufferTicket[]; };

layout(push_constant) uniform PushConstants {
    uint rows;          // copies of the embedding
    uint D;             // embedding width (even)
    float minPeriod;    // the fastest sinusoid, in units of t
    float log2Ratio;    // log2(maxPeriod / minPeriod)
    uint numSteps;      // dispatches before t is back at 1
};

shared uint sStep;

void writeO(uint i, float v) { if (typeO == DTYPE_F32) bufferO_f32[i] = v; else bufferO_f16[i] = float16_t(v); }

void main()
{
    if (gl_LocalInvocationIndex == 0)
    {
        uint W = gl_NumWorkGroups.x * gl_NumWorkGroups.y;
        sStep = (atomicAdd(bufferTicket[0], 1u) / W) % numSteps;
    }
    barrier();

    uint i = gl_GlobalInvocationID.x;    // sin/cos pair index (coalesced)
    uint r = gl_GlobalInvocationID.y;    // row index

    uint half_ = D / 2;
    if (i >= half_ || r >= rows) return;

    const float TWO_PI = 6.28318530717958647692;
    float t = 1.0 - float(sStep) / float(numSteps);
    float f = float(i) / float(half_ - 1);
    float cycles = t / minPeriod * exp2(-f * log2Ratio);
    float angle = TWO_PI * fract(cycles);

    uint idx = r * D + i;
    writeO(idx, sin(angle));
    writeO(idx + half_, cos(angle));
}
