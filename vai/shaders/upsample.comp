/*=============================================================================
 upsample.comp:
     O[c, h * scale + dy, w * scale + dx] = I[c, h, w]

 - Integer-scale nearest-neighbor upsampling in CHW layout.
 - One invocation handles one input element and fills its output tile.
 - Even scales use packed horizontal stores; odd scales use scalar stores.
 - Dispatch (host): (Wi, Hi, C).
=============================================================================*/
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#include "common/spec_constants.h"

layout(local_size_x = 16, local_size_y = 16) in;

layout(constant_id = 0) const uint scale = 2u;
layout(constant_id = SPEC_ID_TYPE_O) const uint typeO = 0u; // O (output) dtype
layout(constant_id = SPEC_ID_TYPE_I) const uint typeI = 0u; // I (input) dtype

layout(set = 0, binding = 0) restrict writeonly buffer O_BUF_F32 { float bufferO_f32[]; };
layout(set = 0, binding = 0) restrict writeonly buffer O_BUF_2F32 { vec2 bufferO_2f32[]; };
layout(set = 0, binding = 0) restrict writeonly buffer O_BUF_4F32 { vec4 bufferO_4f32[]; };
layout(set = 0, binding = 0) restrict writeonly buffer O_BUF_F16 { float16_t bufferO_f16[]; };
layout(set = 0, binding = 0) restrict writeonly buffer O_BUF_2F16 { f16vec2 bufferO_2f16[]; };
layout(set = 0, binding = 0) restrict writeonly buffer O_BUF_4F16 { f16vec4 bufferO_4f16[]; };
layout(set = 0, binding = 1) restrict readonly buffer I_BUF_F32 { float bufferI_f32[]; };
layout(set = 0, binding = 1) restrict readonly buffer I_BUF_F16 { float16_t bufferI_f16[]; };

layout(push_constant) uniform PushConstants {
    uint C;
    uint Hi;
    uint Wi;
};

void writeO(uint i, float v)
{
    if (typeO == DTYPE_F32) bufferO_f32[i] = v;
    else bufferO_f16[i] = float16_t(v);
}

void writeO2(uint i, float v)
{
    if (typeO == DTYPE_F32) bufferO_2f32[i >> 1u] = vec2(v);
    else bufferO_2f16[i >> 1u] = f16vec2(v);
}

void writeO4(uint i, float v)
{
    if (typeO == DTYPE_F32) bufferO_4f32[i >> 2u] = vec4(v);
    else bufferO_4f16[i >> 2u] = f16vec4(v);
}

void main()
{
    const uint w = gl_GlobalInvocationID.x;
    const uint h = gl_GlobalInvocationID.y;
    const uint c = gl_GlobalInvocationID.z;

    if (w >= Wi || h >= Hi || c >= C) return;

    const uint idx = c * (Hi * Wi) + h * Wi + w;
    const float v = (typeI == DTYPE_F32) ? bufferI_f32[idx] : float(bufferI_f16[idx]);

    const uint Ho = Hi * scale;
    const uint Wo = Wi * scale;
    const uint outBase = (c * Ho + h * scale) * Wo + w * scale;

    if ((scale & 3u) == 0u) // scale is a multiple of 4
    {
        [[unroll]] for (uint dy = 0u; dy < scale; ++dy)
        {
            const uint row = outBase + dy * Wo;
            [[unroll]] for (uint dx = 0u; dx < scale; dx += 4u)
                writeO4(row + dx, v);
        }
    }
    else if ((scale & 1u) == 0u)    // scale is a multiple of 2
    {
        [[unroll]] for (uint dy = 0u; dy < scale; ++dy)
        {
            const uint row = outBase + dy * Wo;
            [[unroll]] for (uint dx = 0u; dx < scale; dx += 2u)
                writeO2(row + dx, v);
        }
    }
    else    // scale is odd
    {
        [[unroll]] for (uint dy = 0u; dy < scale; ++dy)
        {
            const uint row = outBase + dy * Wo;
            [[unroll]] for (uint dx = 0u; dx < scale; ++dx)
                writeO(row + dx, v);
        }
    }
}
