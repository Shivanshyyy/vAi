/*=============================================================================
 batchnorm.comp:
     O[c, ...] = γ[c] * (I[c, ...] - μ[c]) * rsqrt(σ²[c] + eps) + β[c]

 - batch normalization, inference mode; CHW layout (channel = idx / HW)
 - O (typeO), I (typeI), γ/β/μ/σ² (typeW) are fp32 or fp16, accessed through
   same-binding buffer aliases.

 Dispatch (host): one thread per output element -> dispatch2(C*HW).
=============================================================================*/
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_16bit_storage : require
#include "common/spec_constants.h"

layout(local_size_x = 256) in;

layout(constant_id = SPEC_ID_TYPE_O) const uint typeO = 0;  // O (output) dtype
layout(constant_id = SPEC_ID_TYPE_I) const uint typeI = 0;  // I (input) dtype
layout(constant_id = SPEC_ID_TYPE_W) const uint typeW = 0;  // γ/β/μ/σ² dtype

layout(set = 0, binding = 0) buffer O_BUF_F32     { float bufferO_f32[]; };
layout(set = 0, binding = 0) buffer O_BUF_F16     { float16_t bufferO_f16[]; };
//////////////////////////////////////////////////////////////////////////////
layout(set = 0, binding = 1) buffer I_BUF_F32     { float bufferI_f32[]; };
layout(set = 0, binding = 1) buffer I_BUF_F16     { float16_t bufferI_f16[]; };
//////////////////////////////////////////////////////////////////////////////
layout(set = 0, binding = 2) buffer GAMMA_BUF_F32 { float bufferGamma_f32[]; };
layout(set = 0, binding = 2) buffer GAMMA_BUF_F16 { float16_t bufferGamma_f16[]; };
layout(set = 0, binding = 3) buffer BETA_BUF_F32  { float bufferBeta_f32[]; };
layout(set = 0, binding = 3) buffer BETA_BUF_F16  { float16_t bufferBeta_f16[]; };
layout(set = 0, binding = 4) buffer MEAN_BUF_F32  { float bufferMean_f32[]; };
layout(set = 0, binding = 4) buffer MEAN_BUF_F16  { float16_t bufferMean_f16[]; };
layout(set = 0, binding = 5) buffer VAR_BUF_F32   { float bufferVar_f32[]; };
layout(set = 0, binding = 5) buffer VAR_BUF_F16   { float16_t bufferVar_f16[]; };

layout(push_constant) uniform PushConstants {
    uint C;   // number of channels
    uint HW;  // spatial elements per channel
    float eps;
};

float readI(uint i)     { return (typeI == DTYPE_F32) ? bufferI_f32[i] : float(bufferI_f16[i]); }
float readGamma(uint c) { return (typeW == DTYPE_F32) ? bufferGamma_f32[c] : float(bufferGamma_f16[c]); }
float readBeta(uint c)  { return (typeW == DTYPE_F32) ? bufferBeta_f32[c] : float(bufferBeta_f16[c]); }
float readMean(uint c)  { return (typeW == DTYPE_F32) ? bufferMean_f32[c] : float(bufferMean_f16[c]); }
float readVar(uint c)   { return (typeW == DTYPE_F32) ? bufferVar_f32[c] : float(bufferVar_f16[c]); }
void writeO(uint i, float v) { if (typeO == DTYPE_F32) bufferO_f32[i] = v; else bufferO_f16[i] = float16_t(v); }

void main()
{
    uint N = C * HW;
    uint e = gl_GlobalInvocationID.x;              // one thread per output element
    if (e >= N) return;

    uint  c = e / HW;
    float n = (readI(e) - readMean(c)) / sqrt(readVar(c) + eps);
    writeO(e, readGamma(c) * n + readBeta(c));
}
