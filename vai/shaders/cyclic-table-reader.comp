/*=============================================================================
 cyclic-table-reader.comp:
     O = TABLE[rowIndex], rowIndex = dispatchIndex % numRows.

 - O (typeO) and TABLE (typeI) are fp32 or fp16 via same-binding buffer
   aliases; a row converts as it is copied when the two differ.
 - aligned == 1 (elemsPerRow % 4 == 0): one thread moves a vec4.
 - WORKGROUP_COUNTER counts workgroups since the host last zeroed it, as in
   time-embedding.comp: every workgroup of the k-th dispatch draws a ticket in
   [k*W, (k+1)*W), so workgroupOrdinal / W is k for all of them.

 Dispatch (host): dispatch2(aligned ? elemsPerRow / 4 : elemsPerRow).
=============================================================================*/
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_16bit_storage : require
#include "common/spec_constants.h"

layout(local_size_x = 256) in;

layout(constant_id = SPEC_ID_TYPE_O) const uint typeO = 0;  // O dtype
layout(constant_id = SPEC_ID_TYPE_I) const uint typeI = 0;  // TABLE dtype
layout(constant_id = SPEC_ID_ALIGNED) const uint aligned = 0;  // 1: vec4 loads and stores

layout(set = 0, binding = 0) writeonly buffer O_BUF_F32     { float bufferO_f32[]; };
layout(set = 0, binding = 0) writeonly buffer O_BUF_F16     { float16_t bufferO_f16[]; };
layout(set = 0, binding = 0) writeonly buffer O_BUF_4F32    { vec4 bufferO_4f32[]; };
layout(set = 0, binding = 0) writeonly buffer O_BUF_4F16    { f16vec4 bufferO_4f16[]; };
//////////////////////////////////////////////////////////////////////////////
layout(set = 0, binding = 1) readonly  buffer TABLE_BUF_F32 { float bufferTable_f32[]; };
layout(set = 0, binding = 1) readonly  buffer TABLE_BUF_F16 { float16_t bufferTable_f16[]; };
layout(set = 0, binding = 1) readonly  buffer TABLE_BUF_4F32 { vec4 bufferTable_4f32[]; };
layout(set = 0, binding = 1) readonly  buffer TABLE_BUF_4F16 { f16vec4 bufferTable_4f16[]; };
//////////////////////////////////////////////////////////////////////////////
layout(set = 0, binding = 2)           buffer WG_COUNT_BUF  { uint bufferWgCount[]; };

layout(push_constant) uniform PushConstants {
    uint elemsPerRow;   // one row of the table, in elements
    uint numRows;       // number of rows in the table
};

float readTable(uint i) { return (typeI == DTYPE_F32) ? bufferTable_f32[i] : float(bufferTable_f16[i]); }
void writeO(uint i, float v) { if (typeO == DTYPE_F32) bufferO_f32[i] = v; else bufferO_f16[i] = float16_t(v); }
vec4 readTable4(uint i4) { return (typeI == DTYPE_F32) ? bufferTable_4f32[i4] : vec4(bufferTable_4f16[i4]); }
void writeO4(uint i4, vec4 v) { if (typeO == DTYPE_F32) bufferO_4f32[i4] = v; else bufferO_4f16[i4] = f16vec4(v); }

shared uint rowIndex;

void main()
{
    if (gl_LocalInvocationIndex == 0)
    {
        uint workgroupsPerDispatch = gl_NumWorkGroups.x * gl_NumWorkGroups.y;
        uint workgroupOrdinal = atomicAdd(bufferWgCount[0], 1u);
        uint dispatchIndex = workgroupOrdinal / workgroupsPerDispatch;
        rowIndex = dispatchIndex % numRows;
    }
    barrier();

    uint i = gl_GlobalInvocationID.x;
    if (aligned != 0u)
    {
        uint vecsPerRow = elemsPerRow / 4u;
        if (i >= vecsPerRow) return;
        writeO4(i, readTable4(rowIndex * vecsPerRow + i));
        return;
    }
    if (i >= elemsPerRow) return;

    writeO(i, readTable(rowIndex * elemsPerRow + i));
}
